name: Create or Update package.json and package-lock.json
on:
  workflow_dispatch:
permissions:
  contents: write

jobs:
  create-pkg:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
 
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
            node-version: '26'